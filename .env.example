# ─────────────────────────────────────────────────────────────────────────
# Home Depot Penny Deal Alert Bot — environment configuration
# Copy this file to ".env" for local dev, or set these as Railway variables.
# ─────────────────────────────────────────────────────────────────────────

# ── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_BOT_TOKEN=

# Channel ID where automated alerts are posted (right-click channel -> Copy ID;
# Developer Mode must be enabled in Discord settings).
DISCORD_ALERTS_CHANNEL_ID=

# Optional separate channel for !check commands. If unset, commands work in the
# alerts channel too.
DISCORD_COMMANDS_CHANNEL_ID=

# Your Discord user ID — used for failure DMs (Phase 3). Optional in Phase 1.
DISCORD_OWNER_ID=

# ── Reddit (PRAW / asyncpraw) ───────────────────────────────────────────────
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# A descriptive user agent, e.g. "penny-deal-bot/0.1 by u/yourusername"
REDDIT_USER_AGENT=penny-deal-bot/0.1 by u/your_reddit_username

# Comma-separated list of subreddits to watch (no "r/" prefix).
REDDIT_SUBREDDITS=homedepot,pennydeals

# How often to poll Reddit, in seconds (60-120 is plenty).
REDDIT_POLL_SECONDS=90

# How many new posts/comments to scan per poll per subreddit.
REDDIT_FETCH_LIMIT=50

# ── Store config ────────────────────────────────────────────────────────────
# Your default Home Depot store number. Find it in the homedepot.com URL after
# setting your store, or via the store locator. North Shore MA candidates:
#   Lynn (#2667), Saugus, Danvers/Peabody (#2660) — VERIFY before trusting.
# Used in Phase 2; harmless to set now.
DEFAULT_STORE_ID=

# Additional stores to watch (Phase 3 multi-store), comma-separated. You can
# also add stores live with the !addstore command. e.g. STORE_IDS=2660,2671
STORE_IDS=

# ── State / database ────────────────────────────────────────────────────────
# SQLite path. On Railway, point this at a mounted volume so it survives
# redeploys, e.g. /data/penny.sqlite3
DB_PATH=data/penny.sqlite3

# ── Phase 2 (inventory checker) — leave blank until Phase 2 ──────────────────
# Provider: "none" (Phase 1, no checking) or "serpapi" (Phase 2).
INVENTORY_PROVIDER=none
SERPAPI_KEY=
# A SKU counts as a "penny hit" if price <= this threshold (USD).
PENNY_PRICE_THRESHOLD=1.00

# ── Phase 3 (LLM SKU fallback) — optional ───────────────────────────────────
# When a post smells like a penny deal but regex finds no SKU, ask Claude to
# extract item ids. Only active when ANTHROPIC_API_KEY is set.
ANTHROPIC_API_KEY=
LLM_FALLBACK_ENABLED=true
# Defaults to the most capable model. For this high-volume extraction you can
# switch to a cheaper model, e.g. LLM_MODEL=claude-haiku-4-5
LLM_MODEL=claude-opus-4-8
# Cap LLM calls per poll cycle to bound cost.
LLM_MAX_CALLS_PER_POLL=5

# ── Web dashboard (Phase 3 stretch) — optional ──────────────────────────────
# Set a port to serve a web dashboard of alert history in the same process.
# Leave blank to stay a portless Railway worker. On a Railway *web* service,
# Railway injects PORT automatically, so you can leave DASHBOARD_PORT blank and
# it'll use PORT. Locally, set DASHBOARD_PORT=8080 then open http://localhost:8080
DASHBOARD_PORT=
# Optional shared secret. If set, the dashboard requires ?token=... (a Railway
# web service is publicly reachable, so set this in production).
DASHBOARD_TOKEN=
